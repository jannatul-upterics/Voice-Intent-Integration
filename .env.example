# Groq API Key (Used by both voice-processing STT and intent-classification LLM)
# Auto-discovered from sibling project .env files if already configured there
GROQ_API_KEY=your_groq_api_key_here

# Sibling Project Path Overrides (Optional - auto-discovered by default in parent folder)
# VOICE_PROCESSING_DIR="../Audio-Conversation-Voice-Response"
# INTENT_CLASSIFICATION_DIR="../Customer-Intent-Classification"

# System Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
